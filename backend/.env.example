# Copy this file to ".env" and fill in real values.
# The .env file is ignored by git, so your secrets stay on your computer.

# --- Used today (Day 1) ---
APP_ENV=development
# From the Neon dashboard -> Connect. Should end with ?sslmode=require
DATABASE_URL=
# Websites allowed to call this API, separated by commas (no spaces needed)
CORS_ORIGINS=http://localhost:5173

# --- Intelligence sources ---
NVD_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSECH_AUTH_KEY=

# --- AI report writer (Gemini first, Groq as backup) ---
GEMINI_API_KEY=
GROQ_API_KEY=
# Pick the Gemini model with the highest free daily limit on your account
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
