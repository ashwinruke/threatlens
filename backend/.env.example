# Copy this file to ".env" and fill in real values.
# The .env file is ignored by git, so your secrets stay on your computer.

# --- Used today (Day 1) ---
APP_ENV=development
# From the Neon dashboard -> Connect. Should end with ?sslmode=require
DATABASE_URL=
# Websites allowed to call this API, separated by commas (no spaces needed)
CORS_ORIGINS=http://localhost:5173

# --- Intelligence sources ---
NVD_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSECH_AUTH_KEY=

# --- AI report writer (two providers; the second one takes over if the first fails) ---
GEMINI_API_KEY=
GROQ_API_KEY=
# Run "python -m scripts.check_gemini_models" to see which Gemini models your key can use
GEMINI_MODEL=gemini-3-flash-preview
GROQ_MODEL=openai/gpt-oss-120b
# Which AI is tried first
AI_PROVIDER_ORDER=groq,gemini

# --- Research agent (follows up leads after scoring; never changes the score) ---
RESEARCH_ENABLED=true
# A smaller model than the report writer's, so the agent uses its own free quota
AGENT_GROQ_MODEL=openai/gpt-oss-20b
# Leave empty to use GEMINI_MODEL as the agent's backup
AGENT_GEMINI_MODEL=
AGENT_MAX_STEPS=3
AGENT_MAX_LOOKUPS=1
DAILY_RESEARCH_CAP=30
