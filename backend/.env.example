# Copy this file to ".env" and fill in real values.
# The .env file is ignored by git, so your secrets stay on your computer.

# --- Used today (Day 1) ---
APP_ENV=development
# From the Neon dashboard -> Connect. Should end with ?sslmode=require
DATABASE_URL=
# Websites allowed to call this API, separated by commas (no spaces needed)
CORS_ORIGINS=http://localhost:5173

# --- Intelligence sources ---
NVD_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSECH_AUTH_KEY=

# --- AI report writer (two providers; the second one takes over if the first fails) ---
GEMINI_API_KEY=
GROQ_API_KEY=
# Run "python -m scripts.check_gemini_models" to see which Gemini models your key can use
GEMINI_MODEL=gemini-3-flash-preview
GROQ_MODEL=openai/gpt-oss-120b
# Which AI is tried first
AI_PROVIDER_ORDER=groq,gemini

# --- Research agent (follows up leads after scoring; never changes the score) ---
RESEARCH_ENABLED=true
# A smaller model than the report writer's, so the agent uses its own free quota
AGENT_GROQ_MODEL=openai/gpt-oss-20b
# Leave empty to use GEMINI_MODEL as the agent's backup
AGENT_GEMINI_MODEL=
AGENT_MAX_STEPS=3
AGENT_MAX_LOOKUPS=1
DAILY_RESEARCH_CAP=30

# --- Watchlists (Phase 4) ---
# The daily check's password. Put the same long random value in GitHub: Settings → Secrets and
# variables → Actions → WATCH_CRON_TOKEN. Empty = the scheduled check is switched off.
WATCH_CRON_TOKEN=
# AI summaries the daily check may write per run (protects the free AI quota)
WATCH_AI_REPORTS_PER_RUN=10
# Optional email alerts, free at resend.com. Without your own verified domain, Resend only
# delivers to the email address your Resend account uses.
RESEND_API_KEY=
ALERT_EMAIL_FROM=ThreatLens <onboarding@resend.dev>
